# Base URL of the AN group backend API. Every call in lib/an-sdk/*
# resolves against this — e.g. NEXT_PUBLIC_AN_API + "/api/products".
# Leave empty during local frontend-only development to hit relative
# paths on the same origin (useful if you run a local mock server on
# the same port), or point it at a deployed/staging AN backend.
NEXT_PUBLIC_AN_API=https://api.example.com

# Google Analytics / Ads IDs used in app/layout.tsx.
NEXT_PUBLIC_GA_ID=G-XXXXXXX
NEXT_PUBLIC_ADS_ID=AW-XXXXXXX

# ===== Auth / SSO (lib/an-sdk/sso.ts) =====
# "direct"  - today's flow: this frontend posts credentials straight to
#             lib/an-sdk/auth.ts (login/signup) and stores the bearer token
#             it gets back. Works with no other vars set.
# "sso"     - the frontend redirects to AN group's shared login page (the
#             same one every other AN group property uses) and receives the
#             signed-in user back at /auth/callback. Requires the two vars
#             below to be set once AN group provides them.
NEXT_PUBLIC_AUTH_MODE=direct
NEXT_PUBLIC_AN_SSO_URL=
NEXT_PUBLIC_AN_SSO_CLIENT_ID=native

# Real-time order/admin updates (lib/socket.js, app/admin/page.js). Used to
# hardcode a specific onrender.com deployment of the old backend — now
# configurable. Leave unset to fall back to http://localhost:5000 for local
# dev against a mock server.
NEXT_PUBLIC_SOCKET_URL=

# Razorpay publishable key used client-side at checkout (app/checkout/page.tsx).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
