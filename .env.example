# Base URL of the AN group backend API. Every call in lib/an-sdk/*
# resolves against this — e.g. NEXT_PUBLIC_AN_API + "/api/products".
# This is the ONLY thing you change to swap backends — nothing else in the
# frontend needs to know or care which backend is answering.
#   - For local dev against the included mock backend:
#       run `npm run mock-backend`, then set this to http://localhost:4000
#   - For AN group's real backend once it exists:
#       set this to their staging/production URL
NEXT_PUBLIC_AN_API=http://localhost:4000

# ANgroup is a multi-business/multi-tenant backend — every scoped request
# (products, vendors, coupons, etc.) needs to say which business it's
# acting as. Set this to Native's business _id once it exists as a
# Business record in ANgroup (see ANGROUP_INTEGRATION_STATUS.md at the
# project root for how this gets created and where this ID comes from).
# Leave blank when pointed at the mock backend — it doesn't use this.
NEXT_PUBLIC_AN_BUSINESS_ID=

# Google Analytics / Ads IDs used in app/layout.tsx.
NEXT_PUBLIC_GA_ID=G-XXXXXXX
NEXT_PUBLIC_ADS_ID=AW-XXXXXXX

# ===== Auth / SSO (lib/an-sdk/sso.ts) =====
# "direct"  - today's flow: this frontend posts credentials straight to
#             lib/an-sdk/auth.ts (login/signup) and stores the bearer token
#             it gets back. Works with no other vars set.
# "sso"     - the frontend redirects to AN group's shared login page (the
#             same one every other AN group property uses) and receives the
#             signed-in user back at /auth/callback. Requires the two vars
#             below to be set once AN group provides them.
NEXT_PUBLIC_AUTH_MODE=direct
NEXT_PUBLIC_AN_SSO_URL=
NEXT_PUBLIC_AN_SSO_CLIENT_ID=native

# Real-time order/admin updates (lib/socket.js, app/admin/page.js). Used to
# hardcode a specific onrender.com deployment of the old backend — now
# configurable. Leave unset to fall back to http://localhost:5000 for local
# dev against a mock server.
NEXT_PUBLIC_SOCKET_URL=

# Razorpay publishable key used client-side at checkout (app/checkout/page.tsx).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ===== AN-Accounting sync (app/api/notify-accounting/route.ts) =====
# A completely separate system from ANgroup above — this is the owner's own
# bookkeeping app. Once an order here is confirmed PAID, this site's own
# server (not the browser — these must never be NEXT_PUBLIC_) pushes the
# sale into AN-Accounting so it shows up as a real invoice + ledger entry
# there automatically. Both optional: unset just skips the push silently.
# ACCOUNTING_API_URL is the full endpoint, e.g.
#   https://your-an-accounting-app.vercel.app/api/external/sales
# ACCOUNTING_API_KEY is this business's key from AN-Accounting's own
# Settings -> Sales API page.
ACCOUNTING_API_URL=
ACCOUNTING_API_KEY=

# ===== ANgroup admin service key (app/api/admin/orders/route.ts) =====
# Server-side only (never NEXT_PUBLIC_) shared secret that lets this
# frontend's admin pages list Native's orders straight from ANgroup
# without a real ANgroup staff session/cookie. Must match ANgroup's own
# ADMIN_SERVICE_KEY env var (see its lib/adminServiceAuth.ts).
ADMIN_SERVICE_KEY=
